# Application
APP_ENV=development
LOG_LEVEL=INFO

# Production Compose only (must be non-default, injected outside git)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Authentication (required for protected API routes; generate a random secret)
AUTH_JWT_SECRET=
AUTH_ISSUER=icia
AUTH_AUDIENCE=icia-api
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_BOOTSTRAP_TOKEN=
AUTH_PASSWORD_MIN_LENGTH=12

# Database
# Compose uses the service hostname below. For host-native checks against the
# published Compose port, override this only in the host process with port 5433.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/contract_intelligence

# Redis
REDIS_URL=redis://redis:6379/0
MAX_UPLOAD_SIZE_MB=25
LOCAL_STORAGE_ROOT=data/storage

# LLM / Embeddings
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GENERATION_MAX_CONTEXT_TOKENS=6000
GENERATION_MAX_OUTPUT_TOKENS=1200
GENERATION_MIN_RERANKER_SCORE=-0.3
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_PATH=data/model-cache
RERANKER_ENABLED=false
RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
RERANKER_MODEL_VERSION=jina-reranker-v1-tiny-en
RERANKER_CACHE_PATH=data/model-cache/reranker
RERANKER_CANDIDATE_K=40
RERANKER_TOP_K=5
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_THREADS=1
RETRIEVAL_RRF_K=60
CHUNK_TARGET_TOKENS=600
CHUNK_SOFT_MAX_TOKENS=1000
CHUNK_HARD_MAX_TOKENS=1500
CHUNK_OVERLAP_TOKENS=40
HNSW_M=16
HNSW_EF_CONSTRUCTION=64

# Object Storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
